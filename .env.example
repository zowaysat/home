# 站点信息
VITE_SITE_NAME = "人间寂寥の主页" # 名称
VITE_SITE_AUTHOR = "人间寂寥" # 作者
VITE_SITE_KEYWORDS = "人间寂寥,个人主页" # 关键词
VITE_SITE_DES = "一个默默无闻的主页" # 站点简介
## 站点地址：只写域名，不要带 https:// 和路径，必须包含后缀（例如 example.com）
## 该值用于页脚链接与 Logo 后缀展示，缺少后缀会导致链接失效
VITE_SITE_URL = "example.com" # 站点地址（请改为你的域名）
VITE_SITE_LOGO = "/images/icon/favicon.ico" # 站点主图标
VITE_SITE_MAIN_LOGO = "/images/icon/logo.png" # 主页图标
VITE_SITE_APPLE_LOGO = "/images/icon/apple-touch-icon.png" # Apple 端图标（文件在 icon 目录）

# 简介文本
VITE_DESC_HELLO = "Hello World !"
VITE_DESC_TEXT = "一个建立于 21 世纪的小站，存活于互联网的边缘"
VITE_DESC_HELLO_OTHER = "Oops !"
VITE_DESC_TEXT_OTHER = "哎呀，这都被你发现了（ 再点击一次可关闭 ）"

# 社交链接
## 请在 src/assets/socialLinks.json 文件中配置

# 网站链接
## 请在 src/assets/siteLinks.json 文件中配置
## 网站链接的图标名称可前往 https://www.xicons.org 自行挑选并在 src/components/Links.vue 中引入

# 天气 Key
## 请前往 高德开放平台注册 Web服务 Key
## 请注意不是 Web端 (JS API)，免费申请，每日上限 5000 次
## 此处提供的服务可能会超量从而无法访问，请自行申请！
## 若此处设为空则尝试 教书先生 API，但该备用接口当前可能不可用，页面会显示占位符
VITE_WEATHER_KEY = ""

# 建站日期
## 若不需要，请设为空即可
## 请按照 YYYY-MM-DD 格式填写或者仅填写年份 YYYY
VITE_SITE_START = "2020-10-24"

# ICP 备案号
## 若不需要，请设为空即可
VITE_SITE_ICP = "豫ICP备2022018134号-1"

# 功能开关（true / false）
## 远程壁纸（Bing / vvhan 风景与二次元）：上游接口多数已失效，默认关闭，仅使用本地壁纸
VITE_FEATURE_REMOTE_WALLPAPER = false
## 自定义光标：会隐藏系统光标并全局劫持鼠标事件，默认关闭
VITE_FEATURE_CUSTOM_CURSOR = false
## 禁用右键菜单：默认关闭
VITE_FEATURE_CONTEXT_MENU_LOCK = false

# 歌曲 API 地址
## 请自行部署 Meting-API（参考 https://github.com/xizeyoupan/Meting-API）
## 上游示例地址 api-meting.imsyy.top 已不可用，必须换成自己的服务
VITE_SONG_API = "https://api-meting.imsyy.top/api"
# 歌曲服务器 ( netease-网易云, tencent-qq音乐 )
VITE_SONG_SERVER = "netease"
# 播放类型 ( song-歌曲, playlist-播放列表, album-专辑, search-搜索, artist-艺术家 )
VITE_SONG_TYPE = "playlist"
# 播放 ID ( 留空则隐藏音乐播放器；配置好自己的 API 后再填写歌单 ID )
VITE_SONG_ID = ""

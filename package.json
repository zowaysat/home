{
  "name": "home",
  "author": "imsyy",
  "github": "https://github.com/imsyy/home",
  "home": "https://imsyy.top",
  "private": true,
  "version": "4.1.4",
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-env.mjs development && vite --host",
    "build": "node scripts/check-env.mjs production && vite build",
    "preview": "vite preview",
    "check:env": "node scripts/check-env.mjs",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:all": "pnpm test && pnpm test:e2e",
    "format": "prettier --write src/",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts,.vue --fix",
    "lint:check": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts,.vue --max-warnings=0"
  },
  "dependencies": {
    "@worstone/vue-aplayer": "^1.0.6",
    "aplayer": "^1.10.1",
    "dayjs": "^1.11.10",
    "element-plus": "^2.14.7",
    "fetch-jsonp": "^1.3.0",
    "lodash-es": "^4.17.21",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "swiper": "^11.1.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@icon-park/vue-next": "^1.4.2",
    "@playwright/test": "1.58.0",
    "@vicons/fa": "^0.12.0",
    "@vicons/utils": "^0.1.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "prettier": "^3.2.5",
    "sass": "^1.75.0",
    "subset-font": "^2.9.0",
    "terser": "^5.30.4",
    "unplugin-auto-import": "^0.17.8",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^6.4.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "3.2.7"
  }
}
